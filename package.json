{
	"name": "eumenes-interact-workspace",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"packages/*",
		"lab"
	],
	"scripts": {
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"typecheck": "bun check",
		"typecheck:core": "bun check --project packages/eumenes-interact/tsconfig.core.json",
		"test": "bun test",
		"build": "cd packages/eumenes-interact && bun run build",
		"check:stack": "bun scripts/check-stack.ts",
		"check:collab": "bun lab/scripts/check-collab-sync.ts",
		"check:dist": "bun run build && node lab/scripts/check-dist-node.mjs",
		"lab": "bun lab/cli/main.ts",
		"mcp": "bun lab/mcp/server.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"oxlint": "1.86.0",
		"typescript": "7.0.2"
	}
}
