{
	"name": "eumenes-interact",
	"version": "0.1.3",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=24.11.1",
		"bun": ">=1.4.4"
	},
	"files": [
		"dist",
		"distribution-manifest.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite.d.ts",
			"default": "./dist/sqlite.js"
		},
		"./adapters/playwright-mcp": {
			"types": "./dist/adapters/playwright-mcp.d.ts",
			"default": "./dist/adapters/playwright-mcp.js"
		},
		"./package.json": "./package.json",
		"./distribution-manifest.json": "./distribution-manifest.json",
		"./parts": {
			"types": "./dist/parts.d.ts",
			"default": "./dist/parts.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/distribution-manifest.mjs"
	},
	"dependencies": {
		"jsonrepair": "3.15.0",
		"zod": "4.6.6"
	}
}
